{
  "name": "fettle-monorepo",
  "private": true,
  "type": "module",
  "version": "3.0.3",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "cli": "pnpm -r --filter '@fettle/cli...' run build && node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.3.0",
    "typescript": "^6.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
